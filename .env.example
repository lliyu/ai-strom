# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不要提交。
# 每个发言者一个 Lark 群自定义机器人：webhook 地址 + 签名校验密钥（开启签名校验后在机器人设置页查看）。
STORM_WEBHOOK_ARCHITECT=
STORM_SECRET_ARCHITECT=
STORM_WEBHOOK_RISK=
STORM_SECRET_RISK=
STORM_WEBHOOK_CHAIR=
STORM_SECRET_CHAIR=

# 预留：OpenAI 兼容接口的模型（DeepSeek、Kimi、Qwen、OpenRouter 等），接入时在 config.json 的 providers 里引用
# DEEPSEEK_API_KEY=
# 预留：Anthropic 兼容接口（如阿里百炼 /apps/anthropic）
# BAILIAN_API_KEY=
